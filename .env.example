# Copy to .env and adjust. These defaults are for LOCAL DEVELOPMENT ONLY.

# Postgres container (docker-compose)
POSTGRES_USER=paperpilot
POSTGRES_PASSWORD=paperpilot-local-only
POSTGRES_DB=paperpilot
# Least-privilege role the API and workers connect as (created by the migrate step).
APP_DB_USER=paperpilot_app
APP_DB_PASSWORD=paperpilot-app-local-only

# API
# psycopg 3 driver; host "db" inside compose, "localhost:5433" from your machine.
DATABASE_URL=postgresql+psycopg://paperpilot:paperpilot-local-only@localhost:5433/paperpilot
# Separate database used by pytest; tests drop and recreate its tables.
TEST_DATABASE_URL=postgresql+psycopg://paperpilot:paperpilot-local-only@localhost:5433/paperpilot_test
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO

# Public-demo abuse limits (defaults shown)
CREATE_RATE_LIMIT_PER_MINUTE=5
DAILY_INVESTIGATION_CAP=200
# Proxies in front of the API that append to X-Forwarded-For (compose: nginx = 1).
TRUSTED_PROXY_HOPS=1
PAPER_SEARCH_RATE_LIMIT_PER_MINUTE=20

# OpenAlex paper search. Works without a key, but keyless calls share $0.10/day
# per outbound IP. A free key (https://openalex.org/settings/api) gives $1/day.
OPENALEX_API_KEY=
DAILY_PROVIDER_CALL_CAP=500
PAPER_SEARCH_CACHE_HOURS=24

# Pipeline retries (local workers)
DISCOVERY_MAX_ATTEMPTS=4
RETRY_BASE_SECONDS=30
